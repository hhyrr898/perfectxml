<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>{{ title or site.title }}</title>
<meta name="description" content="{{ description or site.description }}">
<link rel="canonical" href="{{ site.url }}{{ page.url }}">
<meta name="robots" content="{% if noindex %}noindex,follow{% else %}index,follow,max-image-preview:large{% endif %}">
<meta property="og:title" content="{{ title or site.title }}">
<meta property="og:description" content="{{ description or site.description }}">
<meta property="og:type" content="article">
<style>
body{font-family:system-ui,-apple-system,Segoe UI,Roboto,sans-serif;margin:0;background:#f8fafc;color:#1e293b;line-height:1.75}
header{background:#0f172a;color:#fff}
.wrap{max-width:900px;margin:0 auto;padding:0 18px}
nav a{color:#cbd5e1;text-decoration:none;margin-right:18px;font-size:14px}
nav a:hover{color:#fff}
main{max-width:780px;margin:0 auto;padding:30px 18px 60px}
h1{font-size:28px;line-height:1.3}h2{font-size:21px;margin-top:36px;border-bottom:1px solid #e2e8f0;padding-bottom:6px}
.meta{color:#64748b;font-size:13px;margin-bottom:26px}
a{color:#1d4ed8}
footer{background:#0f172a;color:#94a3b8;font-size:13px;padding:26px 0;margin-top:50px}
.fl{margin-top:10px}.fl a{color:#94a3b8;margin-right:14px;text-decoration:none}
.code{background:#0f172a;color:#e2e8f0;padding:14px;border-radius:8px;overflow-x:auto;font-size:13px}
table{border-collapse:collapse;width:100%}td,th{border:1px solid #cbd5e1;padding:6px 10px;font-size:14px}
</style>
</head>
<body>
<header><div class="wrap" style="padding:16px 18px">
<strong style="margin-right:26px">PerfectXML</strong>
<nav style="display:inline"><a href="/">Home</a><a href="/blog/">Articles</a><a href="/411/">Directory</a><a href="/about/">About</a><a href="/zh/">中文版</a></nav>
</div></header>
<main>
<h1>{{ title or site.title }}</h1>
{% if date %}<div class="meta">{{ date | readableDate }}</div>{% endif %}
{{ content | safe }}
</main>
<footer><div class="wrap">
PerfectXML — data formats and developer resources, online since 2000. <a href="/zh/" style="color:#93c5fd">中文版</a>
{% if friendLinksZh and friendLinksZh.length %}{% endif %}
</div></footer>
</body>
</html>
